# Option A: single connection string (Vercel/Neon) — takes priority when set
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option B: individual vars (local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=promptest
DB_USER=postgres
DB_PASSWORD=postgres

# Claude API key — required for AI-generated content
# Without it, the API falls back to dry-run placeholder text
ANTHROPIC_API_KEY=your-api-key-here
